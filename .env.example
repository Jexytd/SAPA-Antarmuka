# ============================================================
# SAPA BPS 1901 - FRONTEND ENVIRONMENT VARIABLES (.env.example)
# ============================================================
# Salin file ini menjadi .env.local atau .env:
# cp .env.example .env.local

# URL Endpoint REST API Backend Service
# Masukkan URL domain / tunnel backend publik Anda (misal https://api-sapa.bpsbangka.go.id atau ngrok).
# PENTING: Jangan gunakan 'localhost' jika website diakses lewat hosting publik (seperti Vercel).
NEXT_PUBLIC_API_URL=https://your-backend-api-url.ngrok-free.dev

# Token Kunci Keamanan API Backend (dikirimkan lewat header x-api-key)
NEXT_PUBLIC_API_KEY=sapa_bps_secure_token_2026

# Konfigurasi Wilayah Kerja & Versi Aplikasi
NEXT_PUBLIC_APP_NAME="SAPA BPS 1901"
NEXT_PUBLIC_BPS_REGION="Kabupaten Bangka"
NEXT_PUBLIC_BPS_CODE="1901"
NEXT_PUBLIC_APP_VERSION="2.1.0"
